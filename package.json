{
  "name": "chaturbo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @chaturbo/web",
    "dev:api": "npm run dev --workspace @chaturbo/api",
    "dev:cli": "npm run dev --workspace chaturbo-cli",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "seed": "npm run seed --workspace @chaturbo/api"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "20.x"
  }
}
